###############################################
# FastImport Ignore File (.importignore)
# Generated from SKIP_DIRS, SKIP_FILES, SKIP_WILDCARDS
###############################################

# -----------------------------
# Skip directories (match any directory named X)
# -----------------------------
$RECYCLE.BIN/
RECYCLER/
System Volume Information/
Recovery/
MSOCache/
debug/
release/
build/
.vscode/
vcpkg_installed/
__pycache__/

# -----------------------------
# Skip specific files (exact name match)
# -----------------------------
desktop.ini
thumbs.db
WHSArchiveConfig.dat
folder.jpg
folder.jpeg

