###############################################
# FastImport Ignore File (.importignore)
# Corrected + Ideal Version
# Aggressive policy focused on personal content
###############################################

# ============================================
# DIRECTORIES TO IGNORE
# ============================================

# --- System / OS directories ---
$RECYCLE.BIN/
RECYCLER/
System Volume Information/
Recovery/
MSOCache/

# --- Development / build directories ---
debug/
release/
build/
.vscode/
vcpkg_installed/
node_modules/
.git/
.svn/
.vs/
__pycache__/


# ============================================
# SPECIFIC FILES TO IGNORE
# ============================================

# --- System junk ---
desktop.ini
Thumbs.db

# --- Windows Home Server / Media Center junk ---
WHSArchiveConfig.dat

# (folder.jpg / folder.jpeg REMOVED — may contain personal content)


# ============================================
# WILDCARD PATTERNS TO IGNORE
# ============================================

# --------------------------------------------
# Executables / Installers (never personal)
# --------------------------------------------
*.exe
*.dll
*.so
*.dylib
*.msi
*.bat
*.cmd
*.sh
*.app
*.pkg
*.deb
*.rpm

# --------------------------------------------
# System / Cache / Temp Files
# --------------------------------------------
*.tmp
*.bak
*.lnk
*.swp
*.cache
*.old
*.lock
*.lock.json
*.plist

# (REMOVED: *.ini — too broad, only desktop.ini should be ignored)
# (REMOVED: *.db — too broad, may contain personal metadata)
# (REMOVED: *.dat — too broad, may contain personal metadata)

# --------------------------------------------
# Development / Build Artifacts
# --------------------------------------------
*.obj
*.lib
*.slo
*.o
*.class
*.pyc
*.pdb
*.ts
*.map
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
mono_crash.*

# --------------------------------------------
# Non-Personal Media Formats
# (DVD/Blu-ray rips, DVR recordings, disc images)
# --------------------------------------------
*.wtv
*.ts
*.m2ts
*.vob
*.iso
*.img
*.bin
*.cue
VIDEO_TS/
AUDIO_TS/

# --------------------------------------------
# Archives / Compressed Files
# (often contain installers or mixed junk)
# --------------------------------------------
*.zip
*.rar
*.7z
*.tar
*.gz
*.bz2
*.xz
*.cab

# --------------------------------------------
# Large Non-Personal Formats
# --------------------------------------------
*.apk
*.ipa
*.crdownload
*.part
*.torrent

# --------------------------------------------
# Apple iPhoto / iTunes junk
# --------------------------------------------
*.ithmb
*.itc

# (REMOVED: albumart*.jpg — may contain personal artwork)
# (REMOVED: albumart*.jpeg — may contain personal artwork)
